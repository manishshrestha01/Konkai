# Canonical origin. Used for canonical URLs, hreflang, sitemap.xml, robots.txt
# and the URLs inside the JSON-LD. Set this to the real deployment domain.
NEXT_PUBLIC_SITE_URL=https://www.konkaisushi.es

# ---------------------------------------------------------------------------
# Google reviews widget (optional)
# ---------------------------------------------------------------------------
# Google does not allow reviews to be embedded directly, so the live feed comes
# from a third-party service. Create a Google Reviews widget in the vendor's
# dashboard, then set the provider and the id here.
#
#   NEXT_PUBLIC_REVIEWS_PROVIDER=elsight     (or: trustindex)
#   NEXT_PUBLIC_REVIEWS_WIDGET_ID=abc123
#
# Until both are set, the section renders the rating and a link to Google
# instead of the feed — the page builds and deploys either way.
#
# The widget is only requested after the visitor presses its consent button,
# so leaving these unset is a valid, fully functional configuration.
NEXT_PUBLIC_REVIEWS_PROVIDER=
NEXT_PUBLIC_REVIEWS_WIDGET_ID=
